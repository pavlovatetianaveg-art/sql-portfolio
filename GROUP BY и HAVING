-- ============================================
-- GROUP BY и HAVING
-- ============================================
-- Главная идея: GROUP BY группирует строки по признаку (например,
-- по юзеру), а агрегатные функции (COUNT, SUM, AVG) считают
-- показатель внутри каждой группы. HAVING фильтрует уже
-- ПОСЧИТАННЫЕ группы — в отличие от WHERE, который фильтрует
-- сырые строки ДО группировки.


-- --------------------------------------------
-- Пример 1: GROUP BY + SUM — сумма и количество по юзеру
-- --------------------------------------------
-- Бизнес-кейс: Показать, сколько денег и сколько депозитов
-- сделал каждый юзер.

SELECT 
    d.user_id,
    COUNT(d.deposit_id) AS deposits_count,
    SUM(d.amount) AS total_amount
FROM deposits d
GROUP BY d.user_id
ORDER BY total_amount DESC;


-- --------------------------------------------
-- Пример 2: HAVING — фильтр по группе (сумма > 500)
-- --------------------------------------------
-- Бизнес-кейс: Найти email юзеров, чья сумма депозитов
-- больше 500$, отсортировать от самых крупных.

SELECT 
    u.email,
    SUM(d.amount) AS total_amount
FROM users u
JOIN deposits d
    ON u.user_id = d.user_id
GROUP BY u.user_id, u.email
HAVING SUM(d.amount) > 500
ORDER BY total_amount DESC;

-- Важно: в HAVING нужно повторять саму функцию (SUM(d.amount)),
-- алиас (total_amount) там использовать нельзя — HAVING
-- выполняется раньше, чем SELECT, и ещё не "знает" про алиас.
-- А вот в ORDER BY алиас уже использовать можно.


-- --------------------------------------------
-- Пример 3: WHERE + GROUP BY + HAVING вместе
-- --------------------------------------------
-- Бизнес-кейс: Найти email юзеров, у которых сумма депозитов
-- со статусом 'completed' больше 1000$.
-- Фильтр по статусу — это фильтр на СЫРЫЕ строки (WHERE, до группировки).
-- Фильтр по сумме — это фильтр на ПОСЧИТАННУЮ группу (HAVING, после).

SELECT 
    user_id,
    SUM(amount) AS total_amount
FROM deposits
WHERE status = 'completed'
GROUP BY user_id
HAVING SUM(amount) > 1000;


-- ============================================
-- ШПАРГАЛКА
-- ============================================
-- WHERE   -> фильтрует строки ДО группировки (например, статус, дата)
-- GROUP BY -> группирует строки по признаку (например, user_id)
-- HAVING  -> фильтрует ПОСЧИТАННЫЕ группы (например, SUM > 1000)
-- ORDER BY -> сортирует финальный результат (алиасы уже доступны)
--
-- Сигнальный вопрос: "Я фильтрую ОДНУ строку или ПОСЧИТАННУЮ ГРУППУ?"
-- Одна строка -> WHERE. Посчитанная группа -> HAVING.
