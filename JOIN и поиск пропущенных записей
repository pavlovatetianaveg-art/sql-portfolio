-- ============================================
-- JOIN и поиск пропущенных записей
-- ============================================
-- Главная идея: LEFT JOIN сохраняет ВСЕ строки левой таблицы,
-- даже если совпадений в правой таблице нет. Там, где совпадений
-- нет, вместо значений из правой таблицы подставляется NULL.
-- Это позволяет находить "пропавших" — тех, у кого чего-то нет.


-- --------------------------------------------
-- Пример 1: Обычный JOIN (INNER JOIN) — email + заказы
-- --------------------------------------------
-- Бизнес-кейс: Показать email юзера рядом с его заказами
-- (для отдела поддержки, которому пишут клиенты).

SELECT 
    u.email,
    o.order_id,
    o.order_amount
FROM users u
JOIN orders o
    ON u.user_id = o.user_id;

-- Обычный JOIN покажет только тех юзеров, у которых ЕСТЬ заказы.
-- Если у юзера заказов нет — он вообще не попадёт в результат.


-- --------------------------------------------
-- Пример 2: LEFT JOIN + IS NULL — юзеры БЕЗ заказов
-- --------------------------------------------
-- Бизнес-кейс: Найти юзеров, которые зарегистрировались,
-- но ни разу не сделали заказ (классика для retention-отдела).

SELECT 
    u.user_id,
    u.email
FROM users u
LEFT JOIN orders o
    ON u.user_id = o.user_id
WHERE o.order_id IS NULL;

-- Как это работает:
-- 1. LEFT JOIN сохраняет ВСЕХ юзеров, даже без заказов
-- 2. Там, где заказов нет, о.order_id будет NULL
-- 3. WHERE o.order_id IS NULL оставляет только "пустые" случаи


-- --------------------------------------------
-- Пример 3: LEFT JOIN — заказы без доставки
-- --------------------------------------------
-- Бизнес-кейс: Найти заказы, которые ещё не были доставлены.

SELECT 
    o.order_id
FROM orders o
LEFT JOIN deliveries d
    ON o.order_id = d.order_id
WHERE d.order_id IS NULL;


-- ============================================
-- ШПАРГАЛКА
-- ============================================
-- JOIN (INNER)       -> только те строки, где есть совпадение в ОБЕИХ таблицах
-- LEFT JOIN          -> ВСЕ строки левой таблицы + совпадения из правой (или NULL)
-- LEFT JOIN + IS NULL -> находим строки, у которых совпадения в правой таблице НЕТ
--
-- Сигнальные слова в задаче, которые подсказывают LEFT JOIN + IS NULL:
-- "ни разу", "без", "никогда не", "не были"
--
-- Важно: сравнение с пустым значением делается через IS NULL,
-- а не через "= NULL" (это в SQL не сработает).
