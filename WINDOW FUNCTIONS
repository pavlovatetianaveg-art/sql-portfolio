-- ============================================
-- WINDOW FUNCTIONS (Оконные функции)
-- ============================================
-- Главная идея: в отличие от GROUP BY, оконные функции
-- НЕ схлопывают строки в одну — они добавляют посчитанное
-- значение рядом с каждой строкой, сохраняя весь детальный уровень.


-- --------------------------------------------
-- Пример 1: Простое окно — сумма по группе без схлопывания строк
-- --------------------------------------------
-- Бизнес-кейс: Показать каждый заказ, а рядом — сколько всего
-- потратил этот юзер (для контекста, не теряя деталей по заказу).

SELECT 
    order_id,
    user_id,
    order_amount,
    SUM(order_amount) OVER (PARTITION BY user_id) AS total_by_user
FROM orders;

-- Как читать: PARTITION BY user_id говорит "считай сумму отдельно
-- для каждого юзера", но строки таблицы остаются на месте —
-- в отличие от GROUP BY, где юзер "схлопнулся" бы в одну строку.


-- --------------------------------------------
-- Пример 2: Накопительная сумма (running total)
-- --------------------------------------------
-- Бизнес-кейс: Показать динамику трат юзера по датам —
-- сколько он потратил "с начала и до этого заказа включительно".

SELECT 
    order_id,
    user_id,
    order_amount,
    SUM(order_amount) OVER (
        PARTITION BY user_id 
        ORDER BY order_date
    ) AS running_total
FROM orders;

-- Ключевое отличие от Примера 1: добавили ORDER BY order_date
-- ВНУТРИ OVER(...). Это заставляет сумму расти построчно
-- (накопительно), а не считаться сразу по всей группе целиком.


-- ============================================
-- ШПАРГАЛКА: когда какой инструмент нужен
-- ============================================
-- GROUP BY          -> схлопывает строки, считает ОДНО значение на группу
-- PARTITION BY       -> НЕ схлопывает строки, считает значение "рядом"
-- + ORDER BY внутри OVER -> превращает окно в накопительное (running total)
